<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->

	<!--    Abstract beans allow you to define common properties and configurations
	once and reuse them across multiple beans
-->
	<bean name="p1" abstract="true">
		<property name="compName" value="HCL" />
		<property name="empId" value="101"></property>
	</bean>


	<bean name="child" class="learning.spring.entity.Child" parent="p1">
		<property name="age" value="22" />
		<property name="salary" value="78000" />
	</bean>

</beans>